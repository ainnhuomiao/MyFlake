+  // Transparent floating bars blur their capsules, not the empty lane between them.
+  if (instance.barConfig.backgroundOpacity <= 0.0F) {
+    std::vector<InputRect> blurStrips;
+    auto appendRuns = [&blurStrips](const std::vector<BarCapsuleRun>& runs) {
+      for (const auto& run : runs) {
+        if (!run.hasPaintedCapsuleBackground || run.bg == nullptr || !run.bg->visible()) {
+          continue;
+        }
+        float absX = 0.0F;
+        float absY = 0.0F;
+        Node::absolutePosition(run.bg, absX, absY);
+        const int px = static_cast<int>(std::lround(absX));
+        const int py = static_cast<int>(std::lround(absY));
+        const int pw = static_cast<int>(std::lround(std::max(0.0F, run.bg->width())));
+        const int ph = static_cast<int>(std::lround(std::max(0.0F, run.bg->height())));
+        if (pw <= 0 || ph <= 0) {
+          continue;
+        }
+        const Widget* radiusSource = !run.widgets.empty() ? run.widgets.front() : nullptr;
+        const float radius = radiusSource != nullptr
+            ? radiusSource->resolvedBarCapsuleRadius(run.bg->width(), run.bg->height())
+            : std::max(0.0F, std::min(run.bg->width(), run.bg->height()) * 0.5F);
+        auto runStrips = Surface::tessellateRoundedRect(px, py, pw, ph, radius);
+        blurStrips.insert(blurStrips.end(), runStrips.begin(), runStrips.end());
+      }
+    };
+    appendRuns(instance.startCapsuleRuns);
+    appendRuns(instance.centerCapsuleRuns);
+    appendRuns(instance.endCapsuleRuns);
+    if (blurStrips.empty()) {
+      instance.surface->clearBlurRegion();
+    } else {
+      instance.surface->setBlurRegion(blurStrips);
+    }
+    return;
+  }
