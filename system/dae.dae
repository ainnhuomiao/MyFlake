global {
  wan_interface: auto
  tproxy_port: 12345
  tproxy_port_protect: true
  log_level: info
  allow_insecure: false
  auto_config_kernel_parameter: true
  dial_mode: ip
}

dns {
  ipversion_prefer: 4

  upstream {
    ali: "quic://223.5.5.5:853"
    google: "tcp://8.8.8.8:53"
  }

  routing {
    request {
      qname(geosite:cn) -> ali
      fallback: google
    }
  }
}

node {
  p0: "socks5://127.0.0.1:12346"
  p1: "socks5://127.0.0.1:12347"
}

group {
  proxy {
    filter: name(p0)
    policy: fixed(0)
  }

  mining {
    filter: name(p1)
    policy: fixed(0)
  }
}

routing {
  pname(mihomo) -> direct(must)
  pname(NetworkManager) -> direct
  dip(224.0.0.0/3, "ff00::/8", geoip:private) -> direct

  domain(full: auto.c3pool.org) -> mining
  domain(
    full: cm.bilibili.com,
    full: data.bilibili.com,
    full: dataflow.bilibili.com,
    suffix: mcdn.bilivideo.cn,
    geosite:category-ads-all
  ) -> block

  # 自家 attic 缓存：.asia 私有域名不在 geosite:cn，IP 43.153.x 不命中 geoip:cn
  # → 会被 fallback 路由进境外代理节点，导致 TLS 握手间歇 unexpected eof。钉直连。
  domain(full: ainnhuomiao.qianyuanqing.asia) -> direct
  dip(43.153.152.12) -> direct
  domain(geosite:cn) -> direct
  dip(geoip:cn) -> direct

  fallback: proxy
}
